# LOCAL MODE (Ollama on the same computer)
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=local-model

# VERCEL MODE
# Vercel cannot reach Ollama running at 127.0.0.1 on your own computer.
# For a Vercel deployment, set AI_BASE_URL to an HTTPS OpenAI-compatible
# model endpoint that Vercel can reach. Set AI_API_KEY only if that endpoint
# requires authentication. Keep secrets in Vercel Environment Variables,
# never in this repository.
# AI_BASE_URL=https://your-model-endpoint.example/v1
# AI_API_KEY=replace-in-vercel-only
# AI_MODEL=your-model-name

AI_MAX_TOKENS=1800
AI_TEMPERATURE=0.3
